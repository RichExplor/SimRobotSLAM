<?xml version="1.0"?>
<robot name="sim_robot_slam" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <link name="base_footprint">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="base_link">
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0833" ixy="0" ixz="0" iyy="0.1733" iyz="0" izz="0.2267"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.48 0.32 0.12"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.12 0.32 0.62 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.48 0.32 0.12"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.17" rpy="0 0 0"/>
  </joint>

  <link name="front_left_wheel_link">
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0036" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel_link"/>
    <origin xyz="0.17 0.19 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="front_left_wheel_link">
    <mu1>0.02</mu1>
    <mu2>1.0</mu2>
    <fdir1>0.7071068 0 -0.7071068</fdir1>
  </gazebo>

  <link name="rear_right_wheel_link">
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0036" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel_link"/>
    <origin xyz="-0.17 -0.19 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="rear_right_wheel_link">
    <mu1>0.02</mu1>
    <mu2>1.0</mu2>
    <fdir1>0.7071068 0 -0.7071068</fdir1>
  </gazebo>

  <link name="front_right_wheel_link">
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0036" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel_link"/>
    <origin xyz="0.17 -0.19 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="front_right_wheel_link">
    <mu1>0.02</mu1>
    <mu2>1.0</mu2>
    <fdir1>0.7071068 0 0.7071068</fdir1>
  </gazebo>

  <link name="rear_left_wheel_link">
    <inertial>
      <mass value="0.6"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0036" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.0036"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.08 0.08 0.08 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel_link"/>
    <origin xyz="-0.17 0.19 -0.07" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <gazebo reference="rear_left_wheel_link">
    <mu1>0.02</mu1>
    <mu2>1.0</mu2>
    <fdir1>0.7071068 0 0.7071068</fdir1>
  </gazebo>

  <link name="imu_link">
    <inertial>
      <mass value="0.02"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.02"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0.15 0.55 0.22 1"/>
      </material>
    </visual>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.35"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.055" length="0.07"/>
      </geometry>
      <material name="lidar_gray">
        <color rgba="0.18 0.18 0.18 1"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu/data</topic>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001745329252</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.000174532925</bias_stddev>
              <dynamic_bias_stddev>0.000002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001745329252</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.000174532925</bias_stddev>
              <dynamic_bias_stddev>0.000002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.001745329252</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.000174532925</bias_stddev>
              <dynamic_bias_stddev>0.000002</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.05</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.05</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.05</stddev>
              <bias_mean>0.0</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>/lidar/points</topic>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1024</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.2</min>
          <max>60.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheelbase>0.34</wheelbase>
      <wheel_separation>0.38</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel/odometry</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>
</robot>
