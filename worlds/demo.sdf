<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 6 0.6 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>16 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>16 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>0 -6 0.6 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>16 0.2 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>16 0.2 1.2</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>8 0 0.6 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.2 12 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.2 12 1.2</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-8 0 0.6 0 0 0</pose>
      <link name="wall_link">
        <collision name="wall_collision">
          <geometry><box><size>0.2 12 1.2</size></box></geometry>
        </collision>
        <visual name="wall_visual">
          <geometry><box><size>0.2 12 1.2</size></box></geometry>
          <material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_1">
      <static>true</static>
      <pose>2.2 1.0 0.5 0 0 0.25</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision"><geometry><box><size>0.8 0.8 1.0</size></box></geometry></collision>
        <visual name="obstacle_visual">
          <geometry><box><size>0.8 0.8 1.0</size></box></geometry>
          <material><ambient>0.75 0.38 0.16 1</ambient><diffuse>0.75 0.38 0.16 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_2">
      <static>true</static>
      <pose>-2.4 -1.6 0.4 0 0 -0.3</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision"><geometry><box><size>1.2 0.6 0.8</size></box></geometry></collision>
        <visual name="obstacle_visual">
          <geometry><box><size>1.2 0.6 0.8</size></box></geometry>
          <material><ambient>0.16 0.58 0.42 1</ambient><diffuse>0.16 0.58 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
