            <ambient>0.225000009 0.225000009 0.225000009 1</ambient>
          </material>
        </visual>
        <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <topic>/imu/data</topic>
          <imu>
            <angular_velocity>
              <x>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.001745329252</stddev>
                  <bias_mean>0</bias_mean>
                  <bias_stddev>0.00017453292499999999</bias_stddev>
                  <dynamic_bias_stddev>1.9999999999999999e-06</dynamic_bias_stddev>
                  <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.001745329252</stddev>
                  <bias_mean>0</bias_mean>
                  <bias_stddev>0.00017453292499999999</bias_stddev>
                  <dynamic_bias_stddev>1.9999999999999999e-06</dynamic_bias_stddev>
                  <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
                </noise>
              </y>
              <z>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.001745329252</stddev>
                  <bias_mean>0</bias_mean>
                  <bias_stddev>0.00017453292499999999</bias_stddev>
                  <dynamic_bias_stddev>1.9999999999999999e-06</dynamic_bias_stddev>
                  <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
                </noise>
              </z>
            </angular_velocity>
            <linear_acceleration>
              <x>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.050000000000000003</stddev>
                  <bias_mean>0</bias_mean>
                  <bias_stddev>0.0050000000000000001</bias_stddev>
                  <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
                  <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
                </noise>
              </x>
              <y>
                <noise type="gaussian">
                  <mean>0</mean>
                  <stddev>0.050000000000000003</stddev>
                  <bias_mean>0</bias_mean>
                  <bias_stddev>0.0050000000000000001</bias_stddev>
                  <dynamic_bias_stddev>0.0001</dynamic_bias_stddev>
                  <dynamic_bias_correlation_time>3600</dynamic_bias_correlation_time>
